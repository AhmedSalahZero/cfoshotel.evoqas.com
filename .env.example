# CFO Hotels - settings for YOUR computer.
# Copy this file to ".env" (the setup steps do it for you). Never share the ".env" file: it holds passwords.

APP_NAME="CFO Hotels"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://cfo-hotels-vue.test
APP_TIMEZONE=Africa/Cairo

# Language shown first to people who have not chosen one: en (English) or ar (Arabic)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# The database you create with:
#   CREATE DATABASE cfo_hotels_vue CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cfo_hotels_vue
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
CACHE_STORE=database
QUEUE_CONNECTION=database

# E-mails (password reset). "log" writes them to storage/logs instead of sending: safe on your own computer.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@cfohotels.test"
MAIL_FROM_NAME="CFO Hotels"

# The first administrator (created by: php artisan db:seed). Leave ADMIN_PASSWORD empty to get a random one printed on screen.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@cfohotels.test
ADMIN_PASSWORD=

SUPPORT_EMAIL=support@cfohotels.test

# Browser protections: report-only (just log problems) | enforce | off
SECURITY_CSP=report-only
SECURITY_HSTS=true
SECURITY_HEADERS=true

VITE_APP_NAME="${APP_NAME}"
